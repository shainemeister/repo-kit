# Starter ignore list for adopters of repo-kit.
# Extend for your language, tooling, and local conventions.

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Editors / IDE
.vscode/
.idea/
*.swp
*~

# Secrets / local env
.env
.env.*

# Python
__pycache__/
*.py[cod]
*.egg
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Coverage / test runners
.coverage
htmlcov/
.tox/

# Node (light — mixed or frontend-adjacent repos)
node_modules/
